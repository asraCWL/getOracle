# Oracle Free Tier ARM VPS config — generated by setup_mac.sh
# Edit the <FILL_IN_...> placeholders, then run ./vps-ctl.sh test

OCI_CONFIG=./oci_config
OCT_FREE_AD=<FILL_IN_AVAILABILITY_DOMAIN>
SSH_AUTHORIZED_KEYS_FILE=./ssh_public_key.pub
OCI_COMPUTE_SHAPE=VM.Standard.A1.Flex
OCPUS=4
MEMORY_IN_GBS=24
OPERATING_SYSTEM=Canonical Ubuntu
OS_VERSION=24.04
DISPLAY_NAME=oracle-arm-vps
BOOT_VOLUME_SIZE=200
ASSIGN_PUBLIC_IP=true
# 66s tested marginally better than 60/70/80s (fewer wasted 429s, same ~30 real
# capacity-probes/hr — the limiter's token bucket caps throughput regardless).
REQUEST_WAIT_TIME_SECS=66
OCI_SUBNET_ID=<FILL_IN_SUBNET_OCID>
NOTIFY_EMAIL=False
