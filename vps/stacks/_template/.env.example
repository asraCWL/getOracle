# Copy to `.env` (which is gitignored) and fill in. Secrets live ONLY here — never in git.
# The app reads these as environment variables (compose injects them via env_file).

# --- examples (delete what you don't need) ---
# SLACK_WEBHOOK_URL=
# SAXO_CLIENT_ID=
# SAXO_CLIENT_SECRET=
# SOME_API_KEY=

# Keep container time in sync with the host (Denmark).
TZ=Europe/Copenhagen
